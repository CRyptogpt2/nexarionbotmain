async def cmd_start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user  = update.effective_user
    uid   = user.id
    args  = context.args

    referred_by = None
    if args:
        code = args[0]
        if code.startswith("NEX") and code != f"NEX{uid}":
            ref_uid = code.replace("NEX", "")
            if ref_uid.isdigit():
                referred_by = int(ref_uid)

    existing = get_user(uid)
    if not existing:
        register_user(uid, user.username, user.first_name, referred_by)
        if referred_by:
            conn = get_conn()
            conn.execute(
                "INSERT OR IGNORE INTO referrals (referrer_id,referred_id,created_at) VALUES (?,?,?)",
                (referred_by, uid, datetime.now().isoformat())
            )
            conn.commit(); conn.close()

    u = get_user(uid)
    if u["is_banned"]:
        await update.message.reply_text("🚫 You have been banned from this bot.")
        return

    if u["onboarding_complete"]:
        await show_home(update, context, user=u)
        return

    welcome = get_setting("welcome_message")
    kb = InlineKeyboardMarkup([
        [InlineKeyboardButton("📢 Join Channel", url=CHANNEL_LINK)],
        [InlineKeyboardButton("✅ Verify Channel", callback_data="verify_channel")],
    ])
    await update.message.reply_text(welcome, reply_markup=kb, parse_mode="HTML")

