async def cb_task_done(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query   = update.callback_query
    await query.answer()
    uid     = query.from_user.id
    task_id = int(query.data.split("_")[1])

    if task_completed(uid, task_id):
        await query.answer("✅ Already completed!", show_alert=True)
        return

    conn = get_conn()
    t    = conn.execute("SELECT * FROM tasks WHERE task_id=?", (task_id,)).fetchone()
    conn.close()

    # For link-based tasks, check if link was opened
    opened = context.user_data.get("task_opened", set())
    if t["link"] and task_id not in opened:
        await query.answer("❌ Please open the link first!", show_alert=True)
        return

    if mark_task_done(uid, task_id):
        add_points(uid, t["reward"], f"Task: {t['title']}")
        await query.edit_message_text(
            f"🎉 <b>Task Completed!</b>\n\n"
            f"✅ {t['title']}\n"
            f"🎁 +{t['reward']} points earned!",
            reply_markup=InlineKeyboardMarkup([
                [InlineKeyboardButton("📋 More Tasks", callback_data="tasks")],
                [InlineKeyboardButton("🏠 Home", callback_data="home")],
            ]),
            parse_mode="HTML"
        )

