async def try_gsubz(phone, network, amount, wid):
    """Attempt Gsubz API for auto airtime topup."""
    net_map = {"MTN": "mtn", "Airtel": "airtel", "Glo": "glo", "9mobile": "9mobile"}
    try:
        async with aiohttp.ClientSession() as session:
            payload = {
                "api_key": GSUBZ_API_KEY,
                "network": net_map.get(network, network.lower()),
                "phone":   phone,
                "amount":  int(amount),
                "type":    "airtime",
            }
            async with session.post(f"{GSUBZ_BASE_URL}/topup", json=payload, timeout=aiohttp.ClientTimeout(total=15)) as resp:
                data = await resp.json()
                return data.get("status") in ("success", "successful", True, "true")
    except Exception as e:
        logger.error(f"Gsubz API error: {e}")
        return False

