async def cmd_withdrawals(update: Update, context: ContextTypes.DEFAULT_TYPE):
    conn = get_conn()
    rows = conn.execute("SELECT * FROM withdrawals WHERE status='pending' ORDER BY created_at DESC LIMIT 20").fetchall()
    conn.close()
    if not rows:
        await update.message.reply_text("✅ No pending withdrawals."); return
    for w in rows:
        text = (
            f"💸 <b>Withdrawal #{w['id']}</b>\n"
            f"👤 User: {w['user_id']}\n"
            f"📱 {w['phone']} ({w['network']})\n"
            f"💵 ₦{w['amount_naira']:.0f} | {w['points']} pts\n"
            f"📅 {w['created_at'][:16]}"
        )
        await update.message.reply_text(text, reply_markup=InlineKeyboardMarkup([
            [InlineKeyboardButton("✅ Approve", callback_data=f"approve_{w['id']}"),
             InlineKeyboardButton("❌ Reject", callback_data=f"reject_{w['id']}")],
        ]), parse_mode="HTML")

# ── Broadcast ─────────────────────────────────────────────────
@admin_only
async def cmd_broadcast(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "📢 <b>Broadcast</b>\n\nSelect type:",
        reply_markup=InlineKeyboardMarkup([
            [InlineKeyboardButton("📝 Text", callback_data="bc_text"),
             InlineKeyboardButton("🖼 Photo", callback_data="bc_photo")],
            [InlineKeyboardButton("🎥 Video", callback_data="bc_video"),
             InlineKeyboardButton("📄 Document", callback_data="bc_document")],
            [InlineKeyboardButton("❌ Cancel", callback_data="bc_cancel")],
        ]),
        parse_mode="HTML"
    )
    return AWAIT_BROADCAST_TYPE

async def broadcast_type(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    if query.data == "bc_cancel":
        await query.edit_message_text("❌ Broadcast cancelled.")
        return ConversationHandler.END
    bc_type = query.data.replace("bc_", "")
    context.user_data["bc_type"] = bc_type
    prompts = {
        "text": "Send the text message to broadcast:",
        "photo": "Send the photo to broadcast (with caption if needed):",
        "video": "Send the video to broadcast (with caption if needed):",
        "document": "Send the document to broadcast:",
    }
    await query.edit_message_text(prompts.get(bc_type, "Send content:"))
    return AWAIT_BROADCAST_CONTENT

async def broadcast_send(update: Update, context: ContextTypes.DEFAULT_TYPE):
    bc_type = context.user_data.get("bc_type", "text")
    conn    = get_conn()
    users   = conn.execute("SELECT user_id FROM users WHERE is_banned=0").fetchall()
    conn.close()

    sent = failed = 0
    for row in users:
        uid = row["user_id"]
        try:
            if bc_type == "text":
                await context.bot.send_message(uid, update.message.text, parse_mode="HTML")
            elif bc_type == "photo" and update.message.photo:
                await context.bot.send_photo(uid, update.message.photo[-1].file_id,
                                             caption=update.message.caption or "")
            elif bc_type == "video" and update.message.video:
                await context.bot.send_video(uid, update.message.video.file_id,
                                             caption=update.message.caption or "")
            elif bc_type == "document" and update.message.document:
                await context.bot.send_document(uid, update.message.document.file_id,
                                                caption=update.message.caption or "")
            sent += 1
        except Exception:
            failed += 1

    await update.message.reply_text(f"📢 Broadcast done!\n✅ Sent: {sent}\n❌ Failed: {failed}")
    return ConversationHandler.END

