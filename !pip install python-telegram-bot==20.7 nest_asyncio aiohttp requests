async def cmd_start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user   = update.effective_user
    uid    = user.id
    args   = context.args

    # Parse referral code
    referred_by = None
    if args:
        code = args[0]
        if code.startswith("NEX") and code != f"NEX{uid}":
            ref_uid = code.replace("NEX", "")
            if ref_uid.isdigit():
                referred_by = int(ref_uid)

    existing = get_user(uid)
    if not existing:
        register_user(uid, user.username, user.first_name, referred_by)
        if referred_by:
            conn = get_conn()
            conn.execute(
                "INSERT OR IGNORE INTO referrals (referrer_id, referred_id, created_at) VALUES (?,?,?)",
                (referred_by, uid, datetime.now().isoformat())
            )
            conn.commit()
            conn.close()

    u = get_user(uid)

    if u["is_banned"]:
        await update.message.reply_text("🚫 You have been banned from this bot.")
        return

    if u["onboarding_complete"]:
        await show_home(update, context, user=u)
        return

    # Show welcome / onboarding
    welcome = get_setting("welcome_message")
    kb = InlineKeyboardMarkup([
        [InlineKeyboardButton("📢 Join Channel", url=CHANNEL_LINK)],
        [InlineKeyboardButton("✅ Verify Channel", callback_data="verify_channel")],
    ])
    await update.message.reply_text(welcome, reply_markup=kb, parse_mode="HTML")

async def cb_verify_channel(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    uid = query.from_user.id
    u   = get_user(uid)

    if not u:
        await query.answer("Please send /start first.", show_alert=True)
        return

    if u["channel_joined"]:
        # Already verified, move to Twitter step
        await show_twitter_step(query)
        return

    try:
        member = await context.bot.get_chat_member(CHANNEL_UN, uid)
        if member.status in ("member", "administrator", "creator"):
            reward = int(get_setting("channel_reward"))
            add_points(uid, reward, "Channel Join Reward")
            conn = get_conn()
            conn.execute("UPDATE users SET channel_joined=1 WHERE user_id=?", (uid,))
            conn.commit()
            conn.close()
            await query.edit_message_text(
                f"✅ <b>Channel verified!</b>\n\n"
                f"🎁 You've earned <b>{reward} points</b>!\n\n"
                f"Now follow us on X to earn more points 👇",
