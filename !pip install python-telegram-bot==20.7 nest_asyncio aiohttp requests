def get_setting(key):
    conn = get_conn()
    r = conn.execute("SELECT value FROM settings WHERE key=?", (key,)).fetchone()
    conn.close()
    return r["value"] if r else None

def set_setting(key, value):
    conn = get_conn()
    conn.execute("INSERT OR REPLACE INTO settings (key,value) VALUES (?,?)", (key, str(value)))
    conn.commit(); conn.close()

def get_user(user_id):
    conn = get_conn()
    r = conn.execute("SELECT * FROM users WHERE user_id=?", (user_id,)).fetchone()
    conn.close()
    return dict(r) if r else None

def register_user(user_id, username, first_name, referred_by=None):
    code = f"NEX{user_id}"
    conn = get_conn()
    conn.execute("""
        INSERT OR IGNORE INTO users
        (user_id,username,first_name,referral_code,referred_by,join_date)
        VALUES (?,?,?,?,?,?)
    """, (user_id, username or "", first_name or "User", code, referred_by, datetime.now().isoformat()))
    conn.commit(); conn.close()

def add_points(user_id, pts, description, tx_type="earn"):
    conn = get_conn()
    conn.execute("UPDATE users SET points=points+?, total_earned=total_earned+? WHERE user_id=?",
                 (pts, pts, user_id))
    conn.execute("INSERT INTO transactions (user_id,type,points,description,created_at) VALUES (?,?,?,?,?)",
                 (user_id, tx_type, pts, description, datetime.now().isoformat()))
    conn.commit(); conn.close()

def deduct_points(user_id, pts, description, tx_type="withdraw"):
    conn = get_conn()
    conn.execute("UPDATE users SET points=points-?, total_withdrawn=total_withdrawn+? WHERE user_id=?",
                 (pts, pts, user_id))
    conn.execute("INSERT INTO transactions (user_id,type,points,description,created_at) VALUES (?,?,?,?,?)",
                 (user_id, tx_type, pts, description, datetime.now().isoformat()))
    conn.commit(); conn.close()

def get_referral_count(user_id):
    conn = get_conn()
    r = conn.execute("SELECT COUNT(*) as c FROM referrals WHERE referrer_id=?", (user_id,)).fetchone()
    conn.close()
    return r["c"] if r else 0

def get_referral_earnings(user_id):
    conn = get_conn()
    r = conn.execute(
        "SELECT COALESCE(SUM(points),0) as t FROM transactions WHERE user_id=? AND description LIKE '%Referral%'",
        (user_id,)
    ).fetchone()
    conn.close()
    return r["t"] if r else 0

def is_admin(user_id):
    conn = get_conn()
    r = conn.execute("SELECT 1 FROM admins WHERE user_id=?", (user_id,)).fetchone()
    conn.close()
    return r is not None

def get_daily_withdrawn(user_id):
    today = date.today().isoformat()
    conn = get_conn()
    r = conn.execute("""
        SELECT COALESCE(SUM(amount_naira),0) as t FROM withdrawals
        WHERE user_id=? AND status IN ('pending','approved','paid') AND created_at LIKE ?
    """, (user_id, today + "%")).fetchone()
    conn.close()
    return r["t"] if r else 0

def task_completed(user_id, task_id):
    conn = get_conn()
    r = conn.execute("SELECT 1 FROM completed_tasks WHERE user_id=? AND task_id=?",
                     (user_id, task_id)).fetchone()
    conn.close()
    return r is not None

def mark_task_done(user_id, task_id):
    conn = get_conn()
    try:
        conn.execute("INSERT INTO completed_tasks (user_id,task_id,completed_at) VALUES (?,?,?)",
                     (user_id, task_id, datetime.now().isoformat()))
        conn.commit()
        return True
    except sqlite3.IntegrityError:
        return False
    finally:
        conn.close()

