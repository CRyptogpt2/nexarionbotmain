async def databoom_get_network_id(network_name: str) -> int:
    """Fetch real network ID from Databoom API."""
    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(
                f"{DATABOOM_URL}/network-details",
                headers=DATABOOM_HEADERS,
                timeout=aiohttp.ClientTimeout(total=10)
            ) as resp:
                data = await resp.json(content_type=None)
                if data.get("status") == "success":
                    for net in data.get("data", []):
                        if net["network"].upper() == network_name.upper():
                            return net["nId"]
    except Exception as e:
        logger.error(f"Databoom network fetch error: {e}")
    # Return fallback IDs if API fails
    return NETWORK_IDS.get(network_name, 1)

async def databoom_buy_airtime(phone: str, network_name: str, amount: float, wid: int) -> dict:
    """
    Buy airtime using Databoom Nigeria API.
    Returns dict with keys: success (bool), message (str), response (dict)
    """
    try:
        # Get network ID
        network_id = await databoom_get_network_id(network_name)

        # Generate unique ref
        ref = f"NEX{wid}_{int(time.time())}_{random.randint(100,999)}"

        payload = {
            "network":      network_id,
            "phone":        phone,
            "amount":       int(amount),
            "airtime_type": "VTU",
            "ported_number": "false",
            "ref":           ref
        }

        logger.info(f"Databoom airtime request #{wid}: {payload}")

        async with aiohttp.ClientSession() as session:
            async with session.post(
                f"{DATABOOM_URL}/airtime",
                headers=DATABOOM_HEADERS,
                json=payload,
                timeout=aiohttp.ClientTimeout(total=30)
            ) as resp:
                data = await resp.json(content_type=None)
                logger.info(f"Databoom airtime response #{wid}: {data}")

                success = (
                    str(data.get("status", "")).lower() == "success" or
                    str(data.get("Status", "")).lower() in ("success", "successful")
                )
                msg = data.get("msg", str(data))
                return {"success": success, "message": msg, "response": data, "ref": ref}

    except aiohttp.ClientConnectorError:
        return {"success": False, "message": "Network error - could not reach payment provider", "response": {}}
    except asyncio.TimeoutError:
        return {"success": False, "message": "Request timed out - please check with admin", "response": {}}
    except Exception as e:
        logger.error(f"Databoom airtime error #{wid}: {e}")
        return {"success": False, "message": str(e), "response": {}}

async def databoom_check_balance() -> str:
    """Check Databoom wallet balance."""
    try:
        async with aiohttp.ClientSession() as session:
            async with session.post(
                f"{DATABOOM_URL}/user",
                headers=DATABOOM_HEADERS,
                json={},
                timeout=aiohttp.ClientTimeout(total=10)
            ) as resp:
                data = await resp.json(content_type=None)
                if data.get("status") == "success":
                    return data["data"].get("balance", "N/A")
    except Exception as e:
        logger.error(f"Balance check error: {e}")
    return "N/A"

