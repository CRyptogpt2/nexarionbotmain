async def withdraw_network(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query   = update.callback_query
    await query.answer()
    network = query.data.replace("net_", "")
    context.user_data["withdraw"]["network"] = network

    uid        = query.from_user.id
    u          = get_user(uid)
    conv_pts   = int(get_setting("point_conversion_points"))
    conv_naira = int(get_setting("point_conversion_naira"))
    daily_lim  = float(get_setting("daily_limit_naira"))
    daily_used = get_daily_withdrawn(uid)
    daily_left = daily_lim - daily_used

    pts        = u["points"]
    # Calculate max airtime based on points and daily limit
    max_naira  = min((pts / conv_pts) * conv_naira, daily_left)
    # Round down to nearest full conversion block
    blocks     = int(max_naira / conv_naira)
    pts_to_use = blocks * conv_pts
    naira_amt  = blocks * conv_naira

    if pts_to_use <= 0 or naira_amt <= 0:
        await query.edit_message_text(
            "❌ Unable to process withdrawal. Check your balance or daily limit.",
            reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🏠 Home", callback_data="home")]]))
        return ConversationHandler.END

    context.user_data["withdraw"]["points"] = pts_to_use
    context.user_data["withdraw"]["naira"]  = naira_amt

    await query.edit_message_text(
        f"💸 <b>Withdrawal Summary</b>\n\n"
        f"📱 Phone: <b>{context.user_data['withdraw']['phone']}</b>\n"
        f"📡 Network: <b>{network}</b>\n"
        f"🔵 Points to deduct: <b>{pts_to_use}</b>\n"
        f"💵 Airtime to receive: <b>₦{naira_amt:.0f}</b>\n\n"
        f"⚠️ Points will be deducted immediately.\n\n"
        f"Confirm withdrawal?",
        reply_markup=InlineKeyboardMarkup([
            [InlineKeyboardButton("✅ Confirm", callback_data="withdraw_confirm"),
             InlineKeyboardButton("❌ Cancel",  callback_data="home")],
        ]),
        parse_mode="HTML"
    )
    return AWAIT_CONFIRM

async def withdraw_confirm(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    uid   = query.from_user.id
    u     = get_user(uid)
    wd    = context.user_data.get("withdraw", {})

    pts     = wd.get("points", 0)
    naira   = wd.get("naira", 0)
    phone   = wd.get("phone", "")
    network = wd.get("network", "")

    if u["points"] < pts:
        await query.edit_message_text(
            "❌ Insufficient points. Your balance may have changed.",
            reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🏠 Home", callback_data="home")]]))
        return ConversationHandler.END

    # Show processing message
    await query.edit_message_text(
        f"⏳ <b>Processing your withdrawal...</b>\n\n"
        f"📱 Sending ₦{naira:.0f} airtime to {phone}\n\n"
        f"Please wait...",
        parse_mode="HTML"
    )

    # Save withdrawal record first
    conn = get_conn()
    conn.execute("""
        INSERT INTO withdrawals (user_id,phone,network,points,amount_naira,status,created_at)
        VALUES (?,?,?,?,?,'processing',?)
    """, (uid, phone, network, pts, naira, datetime.now().isoformat()))
    wid = conn.execute("SELECT last_insert_rowid()").fetchone()[0]
    conn.commit(); conn.close()

    # Deduct points immediately
    deduct_points(uid, pts, f"Withdrawal ₦{naira:.0f} to {phone} ({network})")

    # Call Databoom API
    result = await databoom_buy_airtime(phone, network, naira, wid)

    # Update withdrawal record with result
    conn = get_conn()
    if result["success"]:
        conn.execute("UPDATE withdrawals SET status='paid', api_ref=?, api_response=? WHERE id=?",
                     (result.get("ref",""), str(result.get("response",{})), wid))
        conn.commit(); conn.close()

        await context.bot.edit_message_text(
            f"✅ <b>Airtime Sent Successfully!</b>\n\n"
            f"📱 Phone: <b>{phone}</b>\n"
            f"📡 Network: <b>{network}</b>\n"
            f"💵 Amount: <b>₦{naira:.0f}</b>\n"
            f"🔵 Points deducted: <b>{pts}</b>\n\n"
            f"Your airtime should arrive within seconds!",
            chat_id=query.message.chat_id,
            message_id=query.message.message_id,
            reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🏠 Home", callback_data="home")]]),
            parse_mode="HTML"
        )
    else:
        # API failed — mark pending, refund is NOT automatic (admin reviews)
        conn.execute("UPDATE withdrawals SET status='pending', api_ref=?, api_response=? WHERE id=?",
                     (result.get("ref",""), str(result.get("response",{})), wid))
        conn.commit(); conn.close()

        await context.bot.edit_message_text(
            f"⏳ <b>Withdrawal Pending</b>\n\n"
            f"📱 Phone: <b>{phone}</b>\n"
            f"📡 Network: <b>{network}</b>\n"
            f"💵 Amount: <b>₦{naira:.0f}</b>\n"
            f"🔵 Points deducted: <b>{pts}</b>\n\n"
            f"⚠️ Auto-processing failed. Your request has been sent to admin for manual processing.\n"
            f"You will be notified once it's done.",
            chat_id=query.message.chat_id,
            message_id=query.message.message_id,
            reply_markup=InlineKeyboardMarkup([[InlineKeyboardButton("🏠 Home", callback_data="home")]]),
            parse_mode="HTML"
        )

        # Notify admin with details
        try:
            await context.bot.send_message(
                ADMIN_ID,
                f"💸 <b>Withdrawal #{wid} Needs Attention</b>\n\n"
                f"👤 User: {uid} (@{u['username'] or 'N/A'}) — {u['first_name']}\n"
                f"📱 Phone: {phone}\n"
                f"📡 Network: {network}\n"
                f"💵 Amount: ₦{naira:.0f}\n"
                f"🔵 Points: {pts}\n\n"
                f"❌ API Error: {result['message']}\n\n"
                f"Use /approvepayment {wid} or /rejectpayment {wid}",
                parse_mode="HTML"
            )
        except Exception:
            pass

    return ConversationHandler.END

