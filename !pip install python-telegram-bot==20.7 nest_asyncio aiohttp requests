                    [InlineKeyboardButton("✅ Done", callback_data="verify_twitter")],
                ]),
                parse_mode="HTML"
            )
        else:
            await query.answer("❌ You haven't joined the channel yet!", show_alert=True)
    except TelegramError:
        await query.answer("❌ Could not verify. Please join and try again.", show_alert=True)

