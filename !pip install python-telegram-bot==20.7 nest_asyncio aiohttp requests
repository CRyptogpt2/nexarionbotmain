async def error_handler(update: object, context: ContextTypes.DEFAULT_TYPE):
    logger.error(f"Update caused error: {context.error}", exc_info=context.error)

def build_app():
    app = ApplicationBuilder().token(BOT_TOKEN).build()

    # ── Withdrawal Conversation ────────────────────────────────
    withdraw_conv = ConversationHandler(
        entry_points=[CallbackQueryHandler(cb_withdraw, pattern="^withdraw$")],
        states={
            AWAIT_PHONE:   [MessageHandler(filters.TEXT & ~filters.COMMAND, withdraw_phone)],
            AWAIT_NETWORK: [CallbackQueryHandler(withdraw_network, pattern="^net_")],
            AWAIT_CONFIRM: [CallbackQueryHandler(withdraw_confirm, pattern="^withdraw_confirm$")],
        },
        fallbacks=[CallbackQueryHandler(cb_home, pattern="^home$")],
        per_message=False,
    )

    # ── Broadcast Conversation ─────────────────────────────────
    broadcast_conv = ConversationHandler(
        entry_points=[CommandHandler("broadcast", cmd_broadcast)],
        states={
            AWAIT_BROADCAST_TYPE: [CallbackQueryHandler(broadcast_type, pattern="^bc_")],
            AWAIT_BROADCAST_CONTENT: [
                MessageHandler(filters.TEXT & ~filters.COMMAND, broadcast_send),
                MessageHandler(filters.PHOTO, broadcast_send),
                MessageHandler(filters.VIDEO, broadcast_send),
                MessageHandler(filters.Document.ALL, broadcast_send),
            ],
        },
        fallbacks=[CommandHandler("cancel", lambda u, c: ConversationHandler.END)],
        per_message=False,
    )

    # ── Add Task Conversation ──────────────────────────────────
    addtask_conv = ConversationHandler(
        entry_points=[CommandHandler("addtask", cmd_addtask)],
        states={
            AWAIT_TASK_TITLE:  [MessageHandler(filters.TEXT & ~filters.COMMAND, addtask_title)],
            AWAIT_TASK_DESC:   [MessageHandler(filters.TEXT & ~filters.COMMAND, addtask_desc)],
            AWAIT_TASK_LINK:   [MessageHandler(filters.TEXT & ~filters.COMMAND, addtask_link)],
            AWAIT_TASK_REWARD: [MessageHandler(filters.TEXT & ~filters.COMMAND, addtask_reward)],
            AWAIT_TASK_TYPE:   [CallbackQueryHandler(addtask_type, pattern="^ttype_")],
        },
        fallbacks=[CommandHandler("cancel", lambda u, c: ConversationHandler.END)],
        per_message=False,
    )

    # ── Register Handlers ──────────────────────────────────────
    app.add_handler(CommandHandler("start", cmd_start))
    app.add_handler(CommandHandler("admin", cmd_admin))
    app.add_handler(CommandHandler("removetask", cmd_removetask))
    app.add_handler(CommandHandler("activatetask", cmd_activatetask))
    app.add_handler(CommandHandler("deactivatetask", cmd_deactivatetask))
    app.add_handler(CommandHandler("searchuser", cmd_searchuser))
    app.add_handler(CommandHandler("addpoints", cmd_addpoints))
    app.add_handler(CommandHandler("removepoints", cmd_removepoints))
    app.add_handler(CommandHandler("banuser", cmd_banuser))
    app.add_handler(CommandHandler("unbanuser", cmd_unbanuser))
    app.add_handler(CommandHandler("withdrawals", cmd_withdrawals))
    app.add_handler(CommandHandler("approvepayment", cmd_approvepayment))
    app.add_handler(CommandHandler("rejectpayment", cmd_rejectpayment))
    app.add_handler(CommandHandler("setreferralreward", cmd_setreferralreward))
    app.add_handler(CommandHandler("setconversion", cmd_setconversion))
    app.add_handler(CommandHandler("setdailylimit", cmd_setdailylimit))
    app.add_handler(CommandHandler("setwelcome", cmd_setwelcome))

    # Conversations (before generic callbacks)
    app.add_handler(withdraw_conv)
    app.add_handler(broadcast_conv)
    app.add_handler(addtask_conv)

    # Onboarding callbacks
    app.add_handler(CallbackQueryHandler(cb_verify_channel, pattern="^verify_channel$"))
    app.add_handler(CallbackQueryHandler(cb_open_twitter,   pattern="^open_twitter$"))
    app.add_handler(CallbackQueryHandler(cb_verify_twitter, pattern="^verify_twitter$"))

    # Home menu callbacks
    app.add_handler(CallbackQueryHandler(cb_home,        pattern="^home$"))
    app.add_handler(CallbackQueryHandler(cb_balance,     pattern="^bal$"))
    app.add_handler(CallbackQueryHandler(cb_referrals,   pattern="^referrals$"))
    app.add_handler(CallbackQueryHandler(cb_tasks,       pattern="^tasks$"))
    app.add_handler(CallbackQueryHandler(cb_profile,     pattern="^profile$"))
    app.add_handler(CallbackQueryHandler(cb_leaderboard, pattern="^leaderboard$"))
    app.add_handler(CallbackQueryHandler(cb_help,        pattern="^help$"))

    # Task callbacks
    app.add_handler(CallbackQueryHandler(cb_task_detail, pattern=r"^task_\d+$"))
    app.add_handler(CallbackQueryHandler(cb_task_open,   pattern=r"^taskopen_\d+$"))
    app.add_handler(CallbackQueryHandler(cb_task_done,   pattern=r"^taskdone_\d+$"))

    app.add_error_handler(error_handler)
    return app

