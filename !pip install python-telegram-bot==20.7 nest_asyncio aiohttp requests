async def broadcast_type(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    if query.data == "bc_cancel":
        await query.edit_message_text("❌ Broadcast cancelled.")
        return ConversationHandler.END
    bc_type = query.data.replace("bc_","")
    context.user_data["bc_type"] = bc_type
    prompts = {
        "text": "Send the text message to broadcast:",
        "photo": "Send the photo to broadcast:",
        "video": "Send the video to broadcast:",
        "document": "Send the document to broadcast:"
    }
    await query.edit_message_text(prompts.get(bc_type, "Send content:"))
    return AWAIT_BROADCAST_CONTENT

async def broadcast_send(update: Update, context: ContextTypes.DEFAULT_TYPE):
    bc_type = context.user_data.get("bc_type","text")
    conn    = get_conn()
    users   = conn.execute("SELECT user_id FROM users WHERE is_banned=0").fetchall()
    conn.close()
    sent = failed = 0
    for row in users:
        uid = row["user_id"]
        try:
            if bc_type == "text":
                await context.bot.send_message(uid, update.message.text, parse_mode="HTML")
            elif bc_type == "photo" and update.message.photo:
                await context.bot.send_photo(uid, update.message.photo[-1].file_id,
                                              caption=update.message.caption or "")
            elif bc_type == "video" and update.message.video:
                await context.bot.send_video(uid, update.message.video.file_id,
                                              caption=update.message.caption or "")
            elif bc_type == "document" and update.message.document:
                await context.bot.send_document(uid, update.message.document.file_id,
                                                 caption=update.message.caption or "")
            sent += 1
        except Exception:
            failed += 1
    await update.message.reply_text(f"📢 Broadcast done!\n✅ Sent: {sent}\n❌ Failed: {failed}")
    return ConversationHandler.END

